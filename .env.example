# Copy to .env.local and fill in. Only PUBLIC client values belong here.
# NEVER put the Supabase service_role key, DB password or any admin token in the app.
# Leave empty to run Cutpick fully local (community shows "not configured").
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Support contact shown in policy screens (required before any public release)
EXPO_PUBLIC_SUPPORT_EMAIL=
