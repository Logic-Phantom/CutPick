{
  "expo": {
    "name": "CutPick",
    "slug": "cutpick",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cutpick",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.cutpick.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.cutpick.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1024",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "CutPick",
      "shortName": "CutPick",
      "themeColor": "#111111",
      "backgroundColor": "#111111"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#111111",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "직접 고른 사진만 불러와 기기 안에서 분석하기 위해 사용해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "추천 결과 사진을 사진 앱에 저장하기 위해 사용해요.",
          "savePhotosPermission": "추천 결과 사진을 순서대로 사진 앱에 저장하기 위해 사용해요.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0032f376-9e06-4027-bb0a-2cf1cfee3b2a"
      }
    },
    "owner": "lcm2"
  }
}
